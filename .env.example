# ─── Infrastructure ───
POSTGRES_DB=stockshield
POSTGRES_USER=stockshield
POSTGRES_PASSWORD=changeme_pg_secret
POSTGRES_PORT=5432

INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=changeme_influx_token
INFLUXDB_ORG=stockshield
INFLUXDB_BUCKET=telemetry

MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=stockshield-backend

# ─── Edge Simulator ───
SIMULATOR_INTERVAL_SEC=5
SIMULATOR_SHELF_COUNT=8

# ─── Java Backend ───
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ─── ML Service ───
ML_SERVICE_PORT=8000
ML_RETRAIN_INTERVAL_HOURS=6
ML_DEFAULT_LEAD_TIME_DAYS=3
ML_DEFAULT_SERVICE_LEVEL=0.95
BACKEND_URL=http://backend:8080

# ─── Alerts (provide real keys to enable) ───
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_PHONE=+1234567890
ALERT_PHONE=+0987654321

SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=alerts@stockshield.local
ALERT_EMAIL=admin@stockshield.local
